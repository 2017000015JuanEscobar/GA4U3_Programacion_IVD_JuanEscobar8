Algoritmo Lecc34_Act1_Inc2
	Definir m,p,h Como Real
	Escribir 'Nombre: Juan Pablo Escobar de Paz'
	Escribir 'IV Bachillerato D, clave 8'
	Escribir "Ingrese su peso (kilogramos)"
	Leer p
	Escribir "Ingrese su altura (metros)"
	Leer h
	m=p/(h^2)
	Escribir "Su cantidad de masa corporal es de: ", m
FinAlgoritmo