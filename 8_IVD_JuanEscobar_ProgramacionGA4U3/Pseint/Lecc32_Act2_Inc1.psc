Algoritmo Lecc32_Act2_Inc1
	Escribir "Nombre: Juan Pablo Escobar de Paz"
	Escribir "IV Bachillerato D, clave 8"
	Definir m, d Como Real
	Escribir 'Ingrese su mes de nacimiento'
	Leer m
	Escribir 'Ingrese su dia de nacimiento'
	Leer d
	Si (m=3 Y d>=21) O (m=4 Y d<=19) Entonces
		Escribir 'Su signo es Aries'
		Escribir 'Su horoscopo es de que va a ser Famoso'
	FinSi
	Si (m=4 Y d>=20) O (m=5 Y d<=20) Entonces
		Escribir 'Su signo es Tauro'
		Escribir 'Su horoscopo es de tendra Salud'
	FinSi
	Si (m=5 Y d>=21) O (m=6 Y d<=20) Entonces
		Escribir 'Su signo es Geminis'
		Escribir 'Su horoscopo es usted una Persona con Valores'
	FinSi
	Si (m=6 Y d>=21) O (m=7 Y d<=22) Entonces
		Escribir 'Su signo es Cancer'
		Escribir 'Su horoscopo es de que va a ser Millonario'
	FinSi
	Si (m=7 Y d>=23) O (m=8 Y d<=22) Entonces
		Escribir 'Su signo es Leo'
		Escribir 'Su horoscopo es de que va a ser Envidioso'
	FinSi
	Si (m=8 Y d>=23) O (m=9 Y d<=22) Entonces
		Escribir 'Su signo es Virgo'
		Escribir 'Su horoscopo es de que usted es Humilde'
	FinSi
	Si (m=9 Y d>=23) O (m=10 Y d<=22) Entonces
		Escribir 'Su signo es Libra'
		Escribir 'Su horoscopo es de que sera Cineasta'
	FinSi
	Si (m=10 Y d>=23) O (m=11 Y d<=21) Entonces
		Escribir 'Su signo es Escorpio'
		Escribir 'Su horoscopo es de que va a entrar en una relacion'
	FinSi
	Si (m=11 Y d>=22) O (m=12 Y d<=21) Entonces
		Escribir 'Su signo es Sagitario'
		Escribir 'Su horoscopo es que usted es Narcisista'
	FinSi
	Si (m=12 Y d>=22) O (m=1 Y d<=19) Entonces
		Escribir 'Su signo es Capricornio'
		Escribir 'Su horoscopo es que sera un Sacerdote'
	FinSi
	Si (m=1 Y d>=20) O (m=2 Y d<=18) Entonces
		Escribir 'Su signo es Acuario'
		Escribir 'Su horoscopo es de que sera un Medico'
	FinSi
	Si (m=2 Y d>=19) O (m=3 Y d<=20) Entonces
		Escribir 'Su signo es Psicis'
		Escribir 'Su horoscopo es de que es alguien muy Respetuoso'
	FinSi
FinAlgoritmo
