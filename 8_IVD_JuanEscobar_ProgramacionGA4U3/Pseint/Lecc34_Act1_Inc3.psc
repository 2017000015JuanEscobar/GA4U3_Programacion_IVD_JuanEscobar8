Algoritmo Lecc34_Act1_Inc3
	Definir c,f,k Como Real
	Escribir 'Nombre: Juan Pablo Escobar de Paz'
	Escribir 'IV Bachillerato D, clave 8'
	Escribir "Ingrese una cantidad en grados centigrados: "
	Leer c
	f=(c*1.8)+32
	k=c+273.15
	
	Escribir "La cantidad en grados farhenheit es de: ",f
	Escribir "La cantidad en grados celsius es de: ",c
	Escribir "La cantidad en grados kelvin es de: ",k
FinAlgoritmo